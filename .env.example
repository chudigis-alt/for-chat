# Copy to .env.local for local development; configure securely in Vercel for production.
DATABASE_URL=
DIRECT_URL=
APP_ORIGIN=
BLOB_READ_WRITE_TOKEN=
ADMIN_SEED_HASH=
ADMIN_REQUIRE_PASSWORD_CHANGE=true

# Render can generate this for initial seeding instead of ADMIN_SEED_HASH.
ADMIN_INITIAL_PASSWORD=
# Production disk storage alternative to Blob; use a persistent mounted disk.
BEL_UPLOAD_DIR=
