# Copy to .env for CLI setup. Next.js also loads .env. Never commit populated files.
# Leave DATABASE_URL empty ONLY for local development (persistent SQLite).
# Set a PostgreSQL connection URL through the production host's secret manager.
DATABASE_URL=
APP_ORIGIN=http://127.0.0.1:5173
TWEEN_DEV_DB=.data/tweentees.sqlite
# Production: replace with an absolute path on a PRIVATE persistent mounted disk.
TWEEN_UPLOAD_DIR=.data/tweentees-uploads
# Optional public website image storage only; cannot store private customer designs.
BLOB_READ_WRITE_TOKEN=
# Only enable behind Vercel's trusted ingress, which overwrites its forwarding header.
TRUST_VERCEL_PROXY=false
# Netlify/serverless: use database storage; leave TWEEN_UPLOAD_DIR empty.
# Production defaults to database storage when no disk or Blob token is configured.
TWEEN_UPLOAD_STORAGE=
# Database storage is capped at 4 MB; disk storage defaults to 10 MB.
TWEEN_MAX_UPLOAD_MB=
